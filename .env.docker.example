# Copy to .env on the admin machine before: docker compose up -d --build
#   cp .env.docker.example .env
#
# No DATABASE_URL / Postgres needed when FORMS_ENGINE_SOURCE=csharp.
# Form editions & questions come from C# SQL Server via APIM.

# Browser UI will be http://<ADMIN_LAN_IP>:3001
CORS_ORIGINS=http://10.147.219.75:3001,http://localhost:3001,http://127.0.0.1:3001

# C# FormsEngine (required for this deploy)
FORMS_ENGINE_SOURCE=csharp
CSHARP_API_BASE_URL=https://YOUR-APIM-HOST/empselser
OCP_APIM_SUBSCRIPTION_KEY=YOUR_APIM_SUBSCRIPTION_KEY
FORMS_ENGINE_FORM_IDS=fw4,colorado

# Optional: require this for POST /internal/fill (match C# FormsEngine:PythonApiKey)
# PYTHON_FILL_API_KEY=
