# Copy to .env and fill in local values. Do not commit .env.

# Required for C# mode (org / Docker deploy) — no Postgres needed
CSHARP_API_BASE_URL=https://YOUR-APIM-HOST/empselser
OCP_APIM_SUBSCRIPTION_KEY=YOUR_APIM_SUBSCRIPTION_KEY
FORMS_ENGINE_SOURCE=csharp
FORMS_ENGINE_FORM_IDS=fw4,colorado

# Only needed for local postgres mode / Phase 4 tests (FORMS_ENGINE_SOURCE=postgres)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/forms_poc

# Optional CORS for Docker UI (comma-separated)
# CORS_ORIGINS=http://10.147.219.75:3001,http://localhost:3001

# Optional: protect POST /internal/fill when Python is publicly reachable
# PYTHON_FILL_API_KEY=
